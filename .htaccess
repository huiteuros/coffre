# Chambre Forte : règles Apache pour l'hébergement (OVH Web Cloud)

# Appli installable : type du manifeste, et service worker toujours revérifié
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

RewriteEngine On

# Tout en HTTPS : les mots de passe et jetons ne doivent jamais circuler en clair
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Fichiers du dépôt qui n'ont rien à faire en ligne : schéma SQL, outils, réglages, fichiers cachés
RewriteRule ^(db|tools|\.claude|node_modules)(/|$) - [F,L]
RewriteRule ^(README\.md|package\.json)$ - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
